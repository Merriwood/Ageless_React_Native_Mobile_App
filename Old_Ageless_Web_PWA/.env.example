###############################################
# Fitness Tracker – Example Environment File  #
###############################################
# Copy this file to `.env` (NEVER commit the real `.env`)
# Fill in the blanks. Unused vars can be removed.
#
# Generate a strong JWT secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# For local Postgres you can run (example with docker):
#   docker run --name ft-pg -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:15
#   DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres
#
# In Render / hosted environments Render injects PORT; you normally omit it.

# === Database ===
DATABASE_URL=postgres://username:password@localhost:5432/fitness_tracker
# Force SSL (overrides hostname heuristic in db.js). Set to false for local.
FORCE_DB_SSL=false

# === Auth / Security ===
JWT_SECRET=replace-with-long-random-hex

# === Runtime ===
NODE_ENV=development
PORT=10000

# === CORS (future tightening) ===
# Comma-separated list of allowed origins. During early dev `*` is acceptable.
CORS_ORIGIN=*

# === Optional Feature Flags (not all wired yet; reserved) ===
# Enable verbose request logging even in production tier
FT_VERBOSE_LOG=false
# Disable automatic DB migration on boot (server currently guards already)
FT_DISABLE_AUTO_MIGRATE=false

# === Notes ===
# After editing .env restart the node process. In Render update environment
# variables via the dashboard and redeploy. Never expose JWT_SECRET publicly.
claude
